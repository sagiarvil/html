{
  "functions": [
    {
      "source": "functions-firebase",
      "codebase": "validator",
      "runtime": "nodejs22",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "wrangler.jsonc",
      "package*.json",
      "functions/**",
      "functions-firebase/**",
      "scripts/**",
      "tests/**"
    ],
    "cleanUrls": true,
    "trailingSlash": true,
    "headers": [
      {
        "source": "**",
        "headers": [
          {"key":"X-Content-Type-Options","value":"nosniff"},
          {"key":"X-Frame-Options","value":"SAMEORIGIN"},
          {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
          {"key":"Strict-Transport-Security","value":"max-age=31536000; includeSubDomains; preload"},
          {"key":"X-Robots-Tag","value":"index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"},
          {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"},
          {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.paddle.com https://news.google.com https://cdnjs.cloudflare.com https://unpkg.com https://cdn.jsdelivr.net; worker-src 'self' blob: https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.paddle.com https://www.photopea.com https://*.photopea.com; connect-src 'self' https://*.paddle.com https://news.google.com https://*.google.com https://cdnjs.cloudflare.com https://unpkg.com https://cdn.jsdelivr.net https://www.photopea.com https://*.photopea.com; child-src 'self' blob: https://www.photopea.com https://*.photopea.com; frame-src https://*.paddle.com https://news.google.com https://*.google.com https://www.photopea.com https://*.photopea.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"},
          {"key":"Vary","value":"Accept-Encoding"},
          {"key":"Server-Timing","value":"cdn-cache;desc=HIT"},
          {"key":"X-Served-By","value":"Firebase-Hosting"}
        ]
      },
      {"source":"**/*.@(html|htm)","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
      {"source":"/","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
      {"source":"/tr*","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
      {"source":"/en*","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
      {"source":"/{tr,en}/**","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]},
      {"source":"/favicon.*","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
      {"source":"/apple-touch-icon.png","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
      {"source":"/assets/favicon-*","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
      {"source":"/assets/icon-*","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
      {"source":"/assets/logo*","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
      {"source":"/enterprise-analyzer","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
      {"source":"/enterprise-analyzer/","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
      {"source":"/enterprise-analyzer/**","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
      {"source":"/enterprise-analyzer*","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
      {"source":"/ai-report","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
      {"source":"/ai-report/**","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
      {"source":"/assets/**","headers":[{"key":"Cache-Control","value":"public, max-age=604800, immutable"}]},
      {"source":"/assets/css/enterprise-theme-system.css","headers":[{"key":"Cache-Control","value":"no-cache, max-age=0, must-revalidate"}]},
      {"source":"/llms.txt","headers":[{"key":"Content-Type","value":"text/markdown; charset=utf-8"},{"key":"Access-Control-Allow-Origin","value":"*"}]},
      {"source":"**/*.xml","headers":[{"key":"Content-Type","value":"application/xml; charset=utf-8"},{"key":"Cache-Control","value":"public, max-age=300, must-revalidate"}]},
      {"source":"/llms/**","headers":[{"key":"Content-Type","value":"text/markdown; charset=utf-8"},{"key":"Access-Control-Allow-Origin","value":"*"},{"key":"Cache-Control","value":"public, max-age=300, stale-while-revalidate=600"}]},
      {"source":"/index.md","headers":[{"key":"Content-Type","value":"text/markdown; charset=utf-8"},{"key":"Access-Control-Allow-Origin","value":"*"}]},
      {"source":"/openapi.json","headers":[{"key":"Content-Type","value":"application/json; charset=utf-8"},{"key":"Access-Control-Allow-Origin","value":"*"}]},
      {"source":"/audit-profile.json","headers":[{"key":"Content-Type","value":"application/json; charset=utf-8"},{"key":"Access-Control-Allow-Origin","value":"*"},{"key":"Cache-Control","value":"public, max-age=3600"}]},
      {"source":"/sources.json","headers":[{"key":"Content-Type","value":"application/json; charset=utf-8"},{"key":"Access-Control-Allow-Origin","value":"*"},{"key":"Cache-Control","value":"public, max-age=3600"}]},
      {"source":"/.well-known/agent-card.json","headers":[{"key":"Content-Type","value":"application/json; charset=utf-8"},{"key":"Access-Control-Allow-Origin","value":"*"}]},
      {"source":"/mcp","headers":[{"key":"Content-Type","value":"application/json; charset=utf-8"},{"key":"Access-Control-Allow-Origin","value":"*"}]}
    ],
    "rewrites": [
      {"source":"/.well-known/agent-card.json","function":{"functionId":"agentCard","region":"us-central1"}},
      {"source":"/mcp","function":{"functionId":"mcp","region":"us-central1"}},
      {"source":"/api/health","function":{"functionId":"health","region":"us-central1"}},
      {"source":"/api/scan","function":{"functionId":"scan","region":"us-central1"}},
      {"source":"/api/scan-v2","function":{"functionId":"scan","region":"us-central1"}},
      {"source":"/api/intelligence","function":{"functionId":"intelligence","region":"us-central1"}},
      {"source":"/api/mandate","function":{"functionId":"mandate","region":"us-central1"}},
      {"source":"/api/delivery","function":{"functionId":"delivery","region":"us-central1"}},
      {"source":"/api/mentions","function":{"functionId":"mentions","region":"us-central1"}},
      {"source":"/api/paddle/config","function":{"functionId":"paddleConfig","region":"us-central1"}},
      {"source":"/api/paddle/entitlement","function":{"functionId":"paddleEntitlement","region":"us-central1"}},
      {"source":"/api/paddle/webhook","function":{"functionId":"paddleWebhook","region":"us-central1"}}
    ],
    "redirects": [
      {"source":"/tr/:path*","destination":"/:path*","type":301},
      {"source":"/en/**","destination":"/","type":301},
      {"source":"/index.html","destination":"/","type":301},
      {"source":"/home","destination":"/","type":301},
      {"source":"/products","destination":"/fiyatlandirma","type":301},
      {"source":"/products.html","destination":"/fiyatlandirma","type":301},
      {"source":"/pricing","destination":"/fiyatlandirma","type":301},
      {"source":"/architecture","destination":"/platform","type":301},
      {"source":"/buy","destination":"/fiyatlandirma","type":301},
      {"source":"/preview","destination":"/","type":301}
    ]
  }
}
