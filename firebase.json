      {"source":"/en/llms-txt-news/2026-08-google-generative-ai-search-reporting-global**","destination":"/en/llms-txt-news/2026-08-28-search-console-generative-ai-data-discrepancies-an-245fb70e11","type":301},
      {"source":"/tr/llms-txt-haberler/2026-openai-search-publisher-discovery**","destination":"/tr/llms-txt-haberler/2026-08-28-oai-searchbot-robots-txt-compliance-and-indexing-g-bbacaa0514","type":301},
      {"source":"/en/llms-txt-news/2026-openai-search-publisher-discovery**","destination":"/en/llms-txt-news/2026-08-28-oai-searchbot-robots-txt-compliance-and-indexing-g-bbacaa0514","type":301},
      {"source":"/tr/llms-txt-haberler/2026-ai-recommendation-consistency**","destination":"/tr/llms-txt-haberler/2026-08-28-brand-salience-and-pmi-scoring-in-large-language-m-8b0b657fa9","type":301},
      {"source":"/en/llms-txt-news/2026-ai-recommendation-consistency**","destination":"/en/llms-txt-news/2026-08-28-brand-salience-and-pmi-scoring-in-large-language-m-8b0b657fa9","type":301},
      {"source":"/tr/llms-txt-haberler/2026-agentic-search-website-readiness**","destination":"/tr/llms-txt-haberler/2026-08-28-future-proofing-digital-content-for-multi-agent-au-bec404b82a","type":301},
      {"source":"/index.html","destination":"/","type":301},
      {"source":"/home","destination":"/","type":301},
      {"source":"/products","destination":"/en/pricing","type":301},
      {"source":"/products.html","destination":"/en/pricing","type":301},
      {"source":"/pricing","destination":"/en/pricing","type":301},
      {"source":"/architecture","destination":"/en/platform","type":301},
      {"source":"/buy","destination":"/en/pricing","type":301},
      {"source":"/preview","destination":"/","type":301}
    ]
  }
