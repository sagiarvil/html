{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "wrangler.jsonc",
      "package*.json",
      "functions/**",
      "scripts/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=604800" },
          { "key": "Access-Control-Allow-Origin", "value": "*" }
        ]
      }
    ],
    "redirects": [
      { "source": "/index.html", "destination": "/", "type": 301 },
      { "source": "/home", "destination": "/", "type": 301 },
      { "source": "/products", "destination": "/#catalog", "type": 301 },
      { "source": "/products.html", "destination": "/#catalog", "type": 301 },
      { "source": "/pricing", "destination": "/#catalog", "type": 301 },
      { "source": "/docs", "destination": "/architecture", "type": 301 },
      { "source": "/terms", "destination": "/licensing", "type": 301 },
      { "source": "/license", "destination": "/licensing", "type": 301 }
    ]
  }
}
