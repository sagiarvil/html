{
  "functions": [
    {
      "source": "functions-firebase",
      "codebase": "validator",
      "runtime": "nodejs22",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "wrangler.jsonc",
      "package*.json",
      "functions/**",
      "functions-firebase/**",
      "scripts/**",
      "tests/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          {"key":"X-Content-Type-Options","value":"nosniff"},
          {"key":"X-Frame-Options","value":"SAMEORIGIN"},
          {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
          {"key":"Strict-Transport-Security","value":"max-age=31536000; includeSubDomains; preload"},
          {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"},
          {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.paddle.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.paddle.com; connect-src 'self' https://*.paddle.com; frame-src https://*.paddle.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"}
        ]
      },
      {"source":"/assets/**","headers":[{"key":"Cache-Control","value":"public, max-age=604800, immutable"}]},
      {"source":"/llms.txt","headers":[{"key":"Content-Type","value":"text/markdown; charset=utf-8"},{"key":"Access-Control-Allow-Origin","value":"*"}]},
      {"source":"/index.md","headers":[{"key":"Content-Type","value":"text/markdown; charset=utf-8"},{"key":"Access-Control-Allow-Origin","value":"*"}]},
      {"source":"/openapi.json","headers":[{"key":"Content-Type","value":"application/json; charset=utf-8"},{"key":"Access-Control-Allow-Origin","value":"*"}]},
      {"source":"/audit-profile.json","headers":[{"key":"Content-Type","value":"application/json; charset=utf-8"},{"key":"Access-Control-Allow-Origin","value":"*"},{"key":"Cache-Control","value":"public, max-age=3600"}]},
      {"source":"/sources.json","headers":[{"key":"Content-Type","value":"application/json; charset=utf-8"},{"key":"Access-Control-Allow-Origin","value":"*"},{"key":"Cache-Control","value":"public, max-age=3600"}]}
    ],
    "rewrites": [
      {"source":"/api/health","function":{"functionId":"health","region":"us-central1"}},
      {"source":"/api/scan","function":{"functionId":"scan","region":"us-central1"}},
      {"source":"/api/intelligence","function":{"functionId":"intelligence","region":"us-central1"}},
      {"source":"/api/mandate","function":{"functionId":"mandate","region":"us-central1"}},
      {"source":"/api/delivery","function":{"functionId":"delivery","region":"us-central1"}},
      {"source":"/api/mentions","function":{"functionId":"mentions","region":"us-central1"}},
      {"source":"/api/paddle/config","function":{"functionId":"paddleConfig","region":"us-central1"}},
      {"source":"/api/paddle/entitlement","function":{"functionId":"paddleEntitlement","region":"us-central1"}},
      {"source":"/api/paddle/webhook","function":{"functionId":"paddleWebhook","region":"us-central1"}}
    ],
    "redirects": [
      {"source":"/tr/llms-txt-haberler/2026-08-ai-visibility-technical-debt**","destination":"/tr/llms-txt-haberler/2026-08-28-ai-visibility-gains-often-mask-structural-technica-1507f0bd2c","type":301},
      {"source":"/en/llms-txt-news/2026-08-ai-visibility-technical-debt**","destination":"/en/llms-txt-news/2026-08-28-ai-visibility-gains-often-mask-structural-technica-1507f0bd2c","type":301},
      {"source":"/tr/llms-txt-haberler/2026-08-google-generative-ai-search-reporting-global**","destination":"/tr/llms-txt-haberler/2026-08-28-search-console-generative-ai-data-discrepancies-an-245fb70e11","type":301},
      {"source":"/en/llms-txt-news/2026-08-google-generative-ai-search-reporting-global**","destination":"/en/llms-txt-news/2026-08-28-search-console-generative-ai-data-discrepancies-an-245fb70e11","type":301},
      {"source":"/tr/llms-txt-haberler/2026-openai-search-publisher-discovery**","destination":"/tr/llms-txt-haberler/2026-08-28-oai-searchbot-robots-txt-compliance-and-indexing-g-bbacaa0514","type":301},
      {"source":"/en/llms-txt-news/2026-openai-search-publisher-discovery**","destination":"/en/llms-txt-news/2026-08-28-oai-searchbot-robots-txt-compliance-and-indexing-g-bbacaa0514","type":301},
      {"source":"/tr/llms-txt-haberler/2026-ai-recommendation-consistency**","destination":"/tr/llms-txt-haberler/2026-08-28-brand-salience-and-pmi-scoring-in-large-language-m-8b0b657fa9","type":301},
      {"source":"/en/llms-txt-news/2026-ai-recommendation-consistency**","destination":"/en/llms-txt-news/2026-08-28-brand-salience-and-pmi-scoring-in-large-language-m-8b0b657fa9","type":301},
      {"source":"/tr/llms-txt-haberler/2026-agentic-search-website-readiness**","destination":"/tr/llms-txt-haberler/2026-08-28-future-proofing-digital-content-for-multi-agent-au-bec404b82a","type":301},
      {"source":"/en/llms-txt-news/2026-agentic-search-website-readiness**","destination":"/en/llms-txt-news/2026-08-28-future-proofing-digital-content-for-multi-agent-au-bec404b82a","type":301},
      {"source":"/favicon.ico","destination":"/favicon.svg","type":302},
      {"source":"/index.html","destination":"/","type":301},
      {"source":"/home","destination":"/","type":301},
      {"source":"/products","destination":"/en/pricing","type":301},
      {"source":"/products.html","destination":"/en/pricing","type":301},
      {"source":"/pricing","destination":"/en/pricing","type":301},
      {"source":"/architecture","destination":"/en/platform","type":301},
      {"source":"/buy","destination":"/en/pricing","type":301},
      {"source":"/preview","destination":"/","type":301}
    ]
  }
}
