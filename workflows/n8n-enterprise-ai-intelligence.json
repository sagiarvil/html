      "parameters": {
        "jsCode": "const domain = ($input.first().json.domain || 'htmlandhtml.com').toLowerCase().replace(/^https?:\\/\\//, '').replace(/\\/.*$/, '').replace(/^www\\./, '');\nreturn [{ json: { normalizedDomain: domain, scanWindow: new Date().toISOString().slice(0,10) } }];"
      },
