      "parameters": {
        "jsCode": "const d = $input.first().json.normalizedDomain;\nif (/^(localhost|127\\.|10\\.|192\\.168\\.|172\\.(1[6-9]|2[0-9]|3[0-1])\\.|169\\.254\\.|::1)/.test(d)) {\n  throw new Error('SSRF_GUARD_TRIGGERED: Private, loopback, or link-local targets blocked.');\n}\nreturn $input.all();"
      },
