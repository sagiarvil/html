{
  "name": "htmlandhtml-firebase-runtime",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "engines": {"node": "22"},
  "scripts": {
    "build": "mkdir -p lib && esbuild ../functions/api/scan.ts --bundle --platform=node --format=cjs --target=node22 --outfile=lib/scan.cjs && esbuild ../functions/api/mandate.ts --bundle --platform=node --format=cjs --target=node22 --outfile=lib/mandate.cjs && esbuild ../functions/api/health.ts --bundle --platform=node --format=cjs --target=node22 --outfile=lib/health.cjs"
  },
  "dependencies": {
    "firebase-functions": "7.3.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
