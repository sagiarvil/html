{
  "name": "htmlandhtml-com",
  "version": "6.0.0",
  "description": "HTML&HTML bilingual 12-engine website diagnosis and paid implementation-mandate platform",
  "private": true,
  "scripts": {
    "test": "npm run test:integrity && npm run test:client",
    "test:integrity": "node tests/integrity/check.mjs",
    "test:client": "node --check assets/js/validator.js",
    "dev": "wrangler pages dev .",
    "pages:deploy": "wrangler pages deploy . --project-name=htmlandhtml-com",
    "firebase:deploy": "npx -y firebase-tools@latest deploy --only hosting",
    "firebase:serve": "npx -y firebase-tools@latest emulators:start --only hosting"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "wrangler": "^3.109.2"
  }
}
