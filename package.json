{
  "name": "htmlandhtml-com",
  "version": "6.9.1",
  "description": "HTML&HTML evidence-backed AI Search Technical Diagnostic Platform: free diagnosis plus a $99 implementation Fix Pack for measurable website-side blockers.",
  "private": true,
  "scripts": {
    "build:commercial": "python3 scripts/build_rss.py",
    "seo:sitemap": "python3 scripts/seo/generate_enterprise_sitemap.py",
    "guard:news-sitemap": "python3 scripts/verify_news_sitemap_guard.py",
    "test": "npm run test:client",
    "test:python": "python3 -m py_compile scripts/build_rss.py",
    "test:integrity": "node --check assets/js/apple-store.js",
    "test:mobile": "node --check assets/js/apple-store.js",
    "test:client": "node --check assets/js/validator.js && node --check assets/js/apple-store.js && node --check assets/js/theme.js && node --check assets/js/enterprise-runtime.js",

    "test:visual": "node tests/visual/mobile-qa.mjs",
    "dev": "wrangler pages dev .",
    "pages:deploy": "wrangler pages deploy . --project-name=htmlandhtml-com",
    "firebase:deploy": "npx -y firebase-tools@latest deploy --only hosting",
    "firebase:serve": "npx -y firebase-tools@latest emulators:start --only hosting"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "playwright": "^1.55.0",
    "wrangler": "^3.109.2"
  }
}
