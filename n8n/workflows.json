{
  "name": "htmlandhtml-18-engine-automation",
  "version": "3.1.0",
  "description": "N8N Orchestration for 18 Deterministic Search & AI Engines, Daily 03:00 Drift Remediation & Multi-Hub IndexNow Broadcast",
  "workflows": [
    {
      "id": "wf-01-daily-maintenance",
      "name": "03:00 UTC Daily Semantic Drift & IndexNow Remediation",
      "active": true,
      "nodes": [
        {
          "name": "Cron Trigger",
          "type": "n8n-nodes-base.cron",
          "parameters": {
            "triggerTimes": {
              "item": [
                {
                  "hour": 3,
                  "minute": 0
                }
              ]
            }
          }
        },
        {
          "name": "Run Health & Drift Check",
          "type": "n8n-nodes-base.httpRequest",
          "parameters": {
            "url": "https://htmlandhtml.com/api/health",
            "method": "GET"
          }
        },
        {
          "name": "Broadcast IndexNow",
          "type": "n8n-nodes-base.executeCommand",
          "parameters": {
            "command": "node scripts/notify-indexnow.mjs"
          }
        }
      ]
    },
    {
      "id": "wf-02-engine-chain-evaluation",
      "name": "18-Engine Composable Execution & DLQ",
      "active": true,
      "nodes": [
        {
          "name": "Scan Input Webhook",
          "type": "n8n-nodes-base.webhook",
          "parameters": {
            "path": "scan-trigger",
            "httpMethod": "POST"
          }
        },
        {
          "name": "Pre-Training Chain (ENG 01-03)",
          "type": "n8n-nodes-base.function"
        },
        {
          "name": "Retrieval Chain (ENG 04-12)",
          "type": "n8n-nodes-base.function"
        },
        {
          "name": "Entity Lock Chain (ENG 13-15)",
          "type": "n8n-nodes-base.function"
        },
        {
          "name": "Defense Layer Chain (ENG 16-18)",
          "type": "n8n-nodes-base.function"
        },
        {
          "name": "Dead Letter Queue on Error",
          "type": "n8n-nodes-base.function"
        }
      ]
    },
    {
      "id": "wf-03-blackbox-observability",
      "name": "Black-Box Intelligence Baseline & Drift Watch",
      "active": false,
      "activationPolicy": "Enable only after provider credentials, neutral prompt cohort, competitor set, persistent baseline store and entitlement are configured.",
      "nodes": [
        {
          "name": "Scheduled Trigger",
          "type": "n8n-nodes-base.cron",
          "parameters": {
            "triggerTimes": {
              "item": [
                {
                  "hour": 6,
                  "minute": 0
                }
              ]
            }
          }
        },
        {
          "name": "Configuration Gate",
          "type": "n8n-nodes-base.function",
          "parameters": {
            "purpose": "Fail closed unless providers, neutral prompts, competitors and baseline storage are configured."
          }
        },
        {
          "name": "Run Website Intelligence",
          "type": "n8n-nodes-base.httpRequest",
          "parameters": {
            "url": "https://htmlandhtml.com/api/intelligence",
            "method": "POST"
          }
        },
        {
          "name": "Run Neutral AI Observations",
          "type": "n8n-nodes-base.httpRequest",
          "parameters": {
            "url": "https://htmlandhtml.com/api/mentions",
            "method": "POST"
          }
        },
        {
          "name": "Compute Six-Domain Delta",
          "type": "n8n-nodes-base.function",
          "parameters": {
            "metrics": [
              "groundingRate",
              "citationConcentrationHHI",
              "brandAnswerShare",
              "entityResolutionDelta",
              "temporalVisibilityDelta",
              "agentInteractionFrictionDelta"
            ]
          }
        },
        {
          "name": "Material Drift Gate",
          "type": "n8n-nodes-base.if",
          "parameters": {
            "policy": "Alert only on threshold breach against like-for-like baseline; never compare different prompt/provider cohorts."
          }
        },
        {
          "name": "Persist Versioned Baseline",
          "type": "n8n-nodes-base.function",
          "parameters": {
            "policy": "Store timestamp, prompt cohort hash, provider/model surface, domain, metrics and evidence refs."
          }
        },
        {
          "name": "Dead Letter Queue",
          "type": "n8n-nodes-base.function",
          "parameters": {
            "policy": "Provider/API failures become NOT_MEASURED and must never overwrite the last valid baseline."
          }
        }
      ]
    }
  ]
}
